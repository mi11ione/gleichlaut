# One month of the public feed in shadow mode with the SL default lane: the local Apertus 8B GGUF on CPU (certified
# build), in process, no model endpoint (docs/operations.md §5b). The venv needs requirements-offline.txt too
# (docs/deploy/README.md). For pre-publication drafting replace the ExecStart arguments with:
#   month --backend llamacpp --gguf ... --items /var/lib/gleichlaut/in/sl-team.json      (and drop --fetch: no network needed)
# Sizing (default Q8_0 build): one requirement, 16 GiB RAM (8.6 GB of weights + KV cache) and 4 CPU cores; ~200 s per
# item on 4 cores. On an 8 GiB box: the Q4_K_M file in --gguf below and MemoryMax=10G (~153 s per item).
# The 70B "fewer edits" variant through a certified endpoint: gleichlaut-month-70b.service.
# Exit codes -> alerts: docs/deploy/README.md. A non-zero exit fails the unit and starts gleichlaut-alert@.
[Unit]
Description=Gleichlaut monthly run, local 8B (shadow mode on the BAG ePL feed)
Wants=network-online.target
After=network-online.target
OnFailure=gleichlaut-alert@%n.service

[Service]
Type=oneshot
User=gleichlaut
Group=gleichlaut
WorkingDirectory=/opt/gleichlaut/track_2b
EnvironmentFile=-/etc/gleichlaut/gleichlaut.env
Environment=PYTHONPATH=/opt/gleichlaut/track_2b/src PYTHONDONTWRITEBYTECODE=1
Environment=GLEICHLAUT_STATE=/var/lib/gleichlaut/state GLEICHLAUT_OUT=/var/lib/gleichlaut/out GLEICHLAUT_HIST=/var/lib/gleichlaut/out/hist
Environment=GLEICHLAUT_MODELS=/var/lib/gleichlaut/models GLEICHLAUT_THREADS=4
# Prometheus textfile (node_exporter --collector.textfile.directory); also add the directory to ReadWritePaths= below
# Environment=GLEICHLAUT_METRICS_DIR=/var/lib/node_exporter/textfile_collector
# the certificate HMAC key, readable only by this unit (systemd >= 248), kept out of the state directory.
# With a key, import a signed build certificate once (gleichlaut-certify.service); without a key, the shipped one is used
# and these two lines are deleted.
LoadCredential=cert.key:/etc/gleichlaut/cert.key
Environment=GLEICHLAUT_CERT_KEY=%d/cert.key
ExecStart=/opt/gleichlaut/venv/bin/python -m gleichlaut month --backend llamacpp --gguf /var/lib/gleichlaut/models/apertus-v1.5-8b-text-q8_0.gguf --from previous --to latest --fetch --emit
StateDirectory=gleichlaut
TimeoutStartSec=24h
# hardening: read-only system, writes only to /var/lib/gleichlaut
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/var/lib/gleichlaut/models
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=18G
CPUQuota=400%
