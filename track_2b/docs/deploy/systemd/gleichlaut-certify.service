# One-off (systemctl start gleichlaut-certify): the build certificate of the pinned Apertus 8B GGUF from its recorded run
# (PREREG R1; the M2 run of the default Q8_0 build), re-scored with the frozen checks and that run's labels, HMAC-signed
# with the key, into the state directory. For Q4_K_M: 8b_q4_k_m_fresh166_g3_final.jsonl, --gguf-sha256
# a037df8d87ff6caacee794ee85f55342f2152e0d359b7389033300c3bee5f299, --labels eval/labels/m1_q4_k_m_fresh166.tsv.
# Seconds, no model, no network. Needed only with GLEICHLAUT_CERT_KEY: without a key the gate accepts the certificate shipped
# in eval/certificates/. To certify on this machine's CPU instead (~9.2 h on 4 cores for Q8_0), replace the arguments with
#   certify --backend llamacpp --gguf /var/lib/gleichlaut/models/apertus-v1.5-8b-text-q8_0.gguf   (and MemoryMax=18G)
[Unit]
Description=Gleichlaut build certificate of the local 8B GGUF
OnFailure=gleichlaut-alert@%n.service

[Service]
Type=oneshot
User=gleichlaut
Group=gleichlaut
WorkingDirectory=/opt/gleichlaut/track_2b
Environment=PYTHONPATH=/opt/gleichlaut/track_2b/src PYTHONDONTWRITEBYTECODE=1
Environment=GLEICHLAUT_STATE=/var/lib/gleichlaut/state
LoadCredential=cert.key:/etc/gleichlaut/cert.key
Environment=GLEICHLAUT_CERT_KEY=%d/cert.key
ExecStart=/opt/gleichlaut/venv/bin/python -m gleichlaut certify --import-run data/runs/8b_q8_0_fresh166_g3_final.jsonl --gguf-sha256 dea904ad80cd725ec89962abae464477f5d8114d1f4377514f381f7dc2ed202d --labels eval/labels/m1_q8_0_fresh166.tsv
StateDirectory=gleichlaut
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
CapabilityBoundingSet=
MemoryMax=1G
