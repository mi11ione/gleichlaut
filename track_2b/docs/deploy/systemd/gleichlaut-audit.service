# Congruence audit of the whole register on the latest feed (docs/operations.md §0): no model, no endpoint.
# --fail-on-findings: exit 8 when a finding is not marked likely equivalent (the audit's own triage), so the alert reaches a reviewer
# (alert.sh: severity reviewer). Exit codes -> alerts: docs/deploy/README.md.
[Unit]
Description=Gleichlaut DE-FR-IT congruence audit (no model)
Wants=network-online.target
After=network-online.target
OnFailure=gleichlaut-alert@%n.service

[Service]
Type=oneshot
User=gleichlaut
Group=gleichlaut
WorkingDirectory=/opt/gleichlaut/track_2b
EnvironmentFile=-/etc/gleichlaut/gleichlaut.env
Environment=PYTHONPATH=/opt/gleichlaut/track_2b/src PYTHONDONTWRITEBYTECODE=1
Environment=GLEICHLAUT_STATE=/var/lib/gleichlaut/state GLEICHLAUT_OUT=/var/lib/gleichlaut/out GLEICHLAUT_HIST=/var/lib/gleichlaut/out/hist
ExecStart=/bin/sh -c 'd=$$(/opt/gleichlaut/venv/bin/python -m gleichlaut feeds --latest) && /opt/gleichlaut/venv/bin/python -m gleichlaut.sl.ingest $$d && exec /opt/gleichlaut/venv/bin/python -m gleichlaut audit --hist /var/lib/gleichlaut/out/hist --date $$d --out /var/lib/gleichlaut/out/audit --fail-on-findings'
StateDirectory=gleichlaut
TimeoutStartSec=1h
# hardening: read-only system, writes only to /var/lib/gleichlaut
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=2G
