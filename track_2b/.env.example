# Model endpoint for the live slice (any OpenAI-compatible endpoint serving Apertus). Leave empty for a fully offline run.
LLM_NAME=swiss-ai/apertus-v1.5-70b
LLM_BASE_URL=
LLM_API_KEY=
# Offline lane (make run-offline): pinned public GGUF of Apertus v1.5 8B (Q4_K_M, 5,059,027,136 bytes) and its sha256.
GLEICHLAUT_MODEL_URL=https://huggingface.co/Colby/apertus-v1.5-8b-text-Q4_K_M-GGUF/resolve/main/apertus-v1.5-8b-text-q4_k_m.gguf
GLEICHLAUT_MODEL_SHA256=a037df8d87ff6caacee794ee85f55342f2152e0d359b7389033300c3bee5f299
# Set to 1 to skip the live model step entirely.
SKIP_MODEL=
# Operations (all optional; defaults in docs/operations.md §2)
GLEICHLAUT_STATE=
GLEICHLAUT_CERT_KEY=
GLEICHLAUT_CERT_DAYS=
GLEICHLAUT_CANARY_MAX_AGE_DAYS=
GLEICHLAUT_TIMEOUT=
GLEICHLAUT_RETRIES=
# Corporate network: passed into the containers by the Makefile
HTTPS_PROXY=
NO_PROXY=
SSL_CERT_FILE=
