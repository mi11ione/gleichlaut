# Model endpoint for the live slice (any OpenAI-compatible endpoint serving Apertus). Leave empty for a fully offline run.
LLM_NAME=swiss-ai/apertus-v1.5-70b
LLM_BASE_URL=
LLM_API_KEY=
# Offline lane (make run-offline, make month): the certified 8B GGUF build. q8_0 (default; 8,567,121,856 bytes, 16 GiB
# RAM) or q4_k_m (5,059,027,136 bytes, an 8 GiB box). Each build's public URL and sha256 are pinned in the code.
GLEICHLAUT_BUILD=q8_0
# Only to fetch the same file from a mirror you control (sha256 of the selected build; any other file needs its own
# build certificate). Q8_0: dea904ad80cd725ec89962abae464477f5d8114d1f4377514f381f7dc2ed202d
# Q4_K_M: a037df8d87ff6caacee794ee85f55342f2152e0d359b7389033300c3bee5f299
GLEICHLAUT_MODEL_URL=
GLEICHLAUT_MODEL_SHA256=
# Set to 1 to skip the live model step entirely.
SKIP_MODEL=
# Operations (all optional; defaults in docs/operations.md §2)
GLEICHLAUT_STATE=
GLEICHLAUT_CERT_KEY=
GLEICHLAUT_CERT_DAYS=
GLEICHLAUT_CANARY_MAX_AGE_DAYS=
GLEICHLAUT_TIMEOUT=
GLEICHLAUT_RETRIES=
# Corporate network: passed into the containers by the Makefile
HTTPS_PROXY=
NO_PROXY=
SSL_CERT_FILE=
