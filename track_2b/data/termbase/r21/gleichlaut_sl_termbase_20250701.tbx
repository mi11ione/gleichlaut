      <admin type="source">BAG SL 01.07.2025, 670 Limitierungen</admin>
     </termSec>
    </langSec>
    <langSec xml:lang="fr">
     <termSec>
      <term>assureur-maladie</term>
      <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
      <admin type="source">extrait de la LS de l'OFSP du 01.07.2025, 372 limitations</admin>
      <note>372 des 670 limitations dont l'allemand contient le terme (56 %)</note>
